# KUT Ajanı — ortam değişkenleri örneği.
# Kurulum betiği (tools/mkclient ile üretilen) çoğunu otomatik ayarlar; bu dosya
# elle kurulum / referans içindir. Boş bırakılan opsiyoneller devre dışıdır.

# --- Bağlantı (ZORUNLU) ---
# C2 sunucusunun enrollment ve agent servis adresleri.
KUT_ENROLL_ADDR=c2.sirket.local:8444
KUT_AGENT_ADDR=c2.sirket.local:8443
# Sunucu sertifikasındaki SAN adı (mTLS doğrulaması).
KUT_SERVER_NAME=kut-c2
# Gömülü CA sertifikası (sunucuyu doğrulamak için güven çıpası) yolu.
KUT_CA_PEM=/etc/kut-agent/ca.crt

# --- Kayıt (ilk açılış) ---
# Tek kullanımlık enrollment token (kaydolduktan sonra tüketilir). Konsoldan üretin.
# Kod-girişli kurulumda boş bırakılıp çalışırken sorulabilir.
KUT_ENROLL_TOKEN=
# Ajan durum/veri dizini (sertifika, tampon, staging).
KUT_AGENT_DATA=/var/lib/kut-agent

# --- mTLS sertleştirme (opsiyonel) ---
# Sunucu SPKI pinning (savunma derinliği): virgülle ayrılmış base64 SHA-256 pin(ler).
# Ayarlıysa sunucu sertifikası CA'ya EK OLARAK pin'e karşı doğrulanır.
# Pin üretme: openssl x509 -in server.crt -pubkey -noout | openssl pkey -pubin \
#   -outform der | openssl dgst -sha256 -binary | openssl base64
KUT_SERVER_SPKI_PIN=

# --- OTA güncelleme + imzalı script (opsiyonel) ---
# OTA manifesto imza doğrulaması için Ed25519 açık anahtarı (base64). Boşsa OTA kapalı.
# İmza-anahtarı ROTASYONU için virgülle ayrılmış BİRDEN ÇOK anahtar verilebilir:
# örtüşme penceresinde eski + yeni anahtar aynı anda güvenilir (herhangi biriyle
# imzalı manifesto kabul edilir).
KUT_UPDATE_PUBKEY=
# İmzalı script yürütme için Ed25519 açık anahtarı (base64). Boşsa script komutları reddedilir.
KUT_SCRIPT_PUBKEY=

# --- Ağ keşfi (opsiyonel) ---
# Yetkili MAC allowlist'i (virgülle). Listede olmayan komşular YETKİSİZ işaretlenir.
KUT_AUTHORIZED_MACS=

# --- Davranışsal anomali (opsiyonel; varsayılan AÇIK) ---
# =1 → anomali tespitini kapat.
KUT_ANOMALY_DISABLE=
# Eğitilmiş model JSON yolu (tools/anomalytrain ile üretilir). İMZALI olmalı.
KUT_ANOMALY_MODEL=
# Modeli doğrulayan Ed25519 açık anahtarı (base64). Yoksa imzasız model YÜKLENMEZ.
KUT_ANOMALY_PUBKEY=

# --- Watchdog / gözetim (opsiyonel) ---
# Watchdog ikilisi yolu; verilirse çift-süreç karşılıklı gözetim açılır.
KUT_WATCHDOG_BIN=

# --- İmzalı çevrimdışı offboard (opsiyonel) ---
# Cihaz C2'ye artık ulaşamıyorsa (satış, iade, imha, ağdan koparılmış depo)
# tamper-koruması (watchdog karşılıklı yeniden başlatma) ajanı canlı tutar.
# Yetkili yönetici, çevrimdışı İMZALI bir "stand-down" jetonu ile bu korumayı
# BİLİNÇLİ olarak durdurabilir. Jeton yalnız aşağıdaki açık anahtarla imzalıysa,
# BU cihaz için ve süresi dolmamışsa kabul edilir; kabul edilince ajan durur ve
# bir işaret dosyası bırakır (watchdog da yeniden başlatmaz).
#
# Jetonu doğrulayan Ed25519 açık anahtar(lar)ı (base64). Boşsa özellik KAPALI.
# Anahtar ROTASYONU için virgülle ayrılmış birden çok anahtar verilebilir.
# Jeton üretme: go run ./tools/offboard -key offboard_ed25519.key -device <id> -ttl 168h
KUT_OFFBOARD_PUBKEY=
# Offboard jetonu (tools/offboard çıktısı) — doğrudan metin olarak.
KUT_OFFBOARD_TOKEN=
# Alternatif: jetonu içeren dosya yolu (KUT_OFFBOARD_TOKEN boşsa okunur).
KUT_OFFBOARD_TOKEN_FILE=

# --- Çalışma ayarları ---
# Heartbeat aralığı (sunucu-saati çıpası + olay flush kadansı).
KUT_HEARTBEAT_INTERVAL=30s
# =1 → SAFE MODE: yıkıcı eylemler (karantina firewall, MDM LOCK/RESTART/WIPE, USB
# engelleme) gerçek OS değişikliği YAPMAZ; yalnız olay üretilir (test/dağıtım başlangıcı).
KUT_SAFE_MODE=

# --- Çıkarılabilir medya (USB) politikası ---
# "audit" (varsayılan): yeni USB depolama olay olarak bildirilir. "block": ayrıca
# gerçek engelleme uygulanır (Windows: mountvol /p ile dismount; Linux: eject) —
# HEDEFLİ + geri döndürülebilir. Engelleme yalnız SAFE MODE KAPALIYKEN uygulanır.
KUT_USB_POLICY=

# --- WIPE ARM (geri döndürülemez veri imhası — ÜÇÜNCÜ güvenlik katmanı) ---
# WIPE komutu geri DÖNDÜRÜLEMEZ kripto-silme yapar (Windows: BitLocker koruyucu
# imhası + zorla kurtarma; Linux: cryptsetup luksErase). Gerçek silme YALNIZ bu
# bayrak =1 iken çalışır; aksi halde WIPE komutu yalnız olay üretir, VERİ SİLİNMEZ.
# (Diğer iki katman: sunucu RBAC=ADMIN ve SAFE MODE kapalı.) Üretimde bilinçli açın.
KUT_ALLOW_WIPE=
# Linux WIPE hedefi: silinecek LUKS aygıtı (ör. /dev/sda3). Yanlış aygıtı silmemek
# için ZORUNLU (otomatik tahmin yok). Windows C: sistem sürücüsünü hedefler.
KUT_WIPE_DEVICE=

# "json" → yapısal JSON loglama (SIEM); boş/diğer → "[agent] " prefix'li metin.
KUT_LOG_FORMAT=

# --- Dosya bütünlüğü izleme (FIM) ---
# Virgülle ayrılmış dosya/dizin yolları izlenir: SHA-256 özetleri periyodik alınır,
# ekleme/değiştirme/silme SECURITY olayı olarak bildirilir (kalıcılık/tamper/fidye
# tespiti). Ör: /etc,/usr/bin,%ProgramFiles%\KUT Agent. Boşsa kapalı.
KUT_FIM_PATHS=

# --- İçerik-tarama (YARA-tarzı imza taraması) ---
# Virgülle ayrılmış dosya/dizin yolları, İMZALI kural kümesine karşı taranır;
# eşleşen dosyalar SECURITY olayı olur (zararlı-yazılım/istenmeyen içerik tespiti).
# İçerik-tarama I/O-ağırdır; uyum kadansında (periyodik) çalışır. Boşsa KAPALI.
KUT_YARA_PATHS=
# İmzalı kural dosyası (JSON) yolu. İmza <dosya>.sig içinde base64 beklenir.
# Üretme: go run ./tools/yarasign -key scan_ed25519.key -rules rules.json
KUT_YARA_RULES=
# Kuralları doğrulayan Ed25519 açık anahtar (base64). Kurallar YALNIZ imza
# doğrulanınca yüklenir (fail-closed); yoksa/geçersizse tarama DEVRE DIŞI kalır.
# (Kötü amaçlı imzalar ikiliye GÖMÜLMEZ — yalnız imzalı harici dosyadan gelir.)
KUT_YARA_PUBKEY=
# Taranacak dosya için üst boyut sınırı (varsayılan 10MB). Ör: 10MB, 5242880.
KUT_YARA_MAXSIZE=

# --- Çıkarılabilir medya DLP (veri sızıntısı sinyalleri, opsiyonel) ---
# Virgülle ayrılmış yollar (ör. USB bağlama noktaları: E:\,F:\ veya /media/usb)
# hassas veri için taranır: kredi kartı (Luhn), TCKN, IBAN (mod-97), e-posta.
# Bulgu POLICY_VIOLATION olur. GİZLİLİK (KVKK): yalnız TÜR + SAYI raporlanır —
# ham hassas değer ASLA olaya yazılmaz. I/O-ağır: uyum kadansında çalışır. Boşsa kapalı.
KUT_DLP_PATHS=
# Taranacak dosya için üst boyut sınırı (varsayılan 5MB). Ör: 5MB, 2097152.
KUT_DLP_MAXSIZE=

# --- DNS telemetri + DGA tespiti (opsiyonel) ---
# =1 → OS DNS önbelleği periyodik taranır; YENİ alan sorguları NETWORK_DISCOVERY,
# Alan-Üretim-Algoritması (DGA) şüphelileri (yüksek entropi/rakam yoğun/düşük sesli
# harf) SECURITY olayı olur (bot ağı C2 rendezvous tespiti). İlk tarama taban çizgisi.
# Toplama şu an Windows'ta (ipconfig /displaydns); DGA skorlaması her platformda.
KUT_DNS_MONITOR=

# --- Kalıcılık (autostart) izleme ---
# Varsayılan AÇIK. Windows Run anahtarları + zamanlanmış görevler, Linux cron +
# etkin systemd servisleri izlenir; YENİ girdiler POLICY_VIOLATION olayı olur
# (MITRE TA0003). Kapatmak için herhangi bir değere ayarlayın.
KUT_PERSISTENCE_DISABLE=
